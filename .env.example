# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-only. Never expose this in browser code.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Portal
# Safe to ship in the browser.
NEXT_PUBLIC_PORTAL_KEY=pk_your_portal_key
# Server-side Portal API origin.
PORTAL_API_URL=https://api.useportal.co
# Server-only. Used for scoped tokens and Portal deployment.
PORTAL_SECRET=sk_your_portal_secret

# OpenCode Zen
# Server-only.
OPENCODE_ZEN_API_KEY=your_opencode_zen_api_key
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=mimo-v2.5-free
# Or use OpenAI directly. If set, these values take precedence over Zen.
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# GitHub Actions production-only (do not put this in local .env files).
DATABASE_URL_PROD=postgresql://postgres:[YOUR-PASSWORD]@db.mryrjaottzqmjyhqngmo.supabase.co:5432/postgres
