rooms\", {\n+      method: \"POST\",\n+      headers: { \"content-type\": \"application/json\" },\n+      body: JSON.stringify({ capacity, alias: \"Gato Ninja\", avatar: \"#21D4D4\" }),\n+    });\n+    const payload = (await response.json()) as { code?: string };\n+    if (!response.ok || !payload.code) {\n+      setError(\"No se pudo crear la sala.\");\n+      return;\n+    }\n+    setCode(payload.code);\n+    setCreated(true);\n+  }\n+\n+  return (\n@@\n-                <button type=\"button\" className=\"choice active\">\n+                <button type=\"button\" className={capacity === 4 ? \"choice active\" : \"choice\"} onClick={() => setCapacity(4)}>\n                   4\n                 </button>\n-                <button type=\"button\" className=\"choice\">\n+                <button type=\"button\" className={capacity === 5 ? \"choice active\" : \"choice\"} onClick={() => setCapacity(5)}>\n                   5\n                 </button>\n@@\n-            onClick={() => setCreated(true)}\n+            onClick={() => void createRoom()}\n@@\n             Crear sala ahora\n           </button>\n+          {error ? <p role=\"alert\">{error}</p> : null}\n*** Update File: /home/agent/workspace/src/app/room/[roomId]/page.tsx\n@@\n import { useParams, useRouter } from \"next/navigation\";\n+import { useEffect, useState } from \"react\";\n@@\n import { RoundRoom } from \"@/app/round-room\";\n+\n+type PublicRoom = {\n+  code: string;\n+  capacity: 4 | 5;\n+  humanCount: number;\n+  status: \"lobby\" | \"started\" | \"expired\" | \"cancelled\";\n+  agentReady: boolean;\n+};\n@@\n   const router = useRouter();\n   const roomId = params.roomId?.toUpperCase() ?? \"\";\n+  const [room, setRoom] = useState<PublicRoom | null>(null);\n+  const [confirmed, setConfirmed] = useState(false);\n+  const [error, setError] = useState<string | null>(null);\n+\n+  useEffect(() => {\n+    let active = true;\n+    void fetch(`/api/rooms/${roomId}`)\n+      .then(async (response) => {\n+        const payload = (await response.json()) as PublicRoom | { error?: string };\n+        if (!response.ok || !(\"code\" in payload)) throw new Error(\"room\");\n+        if (active) setRoom(payload);\n+      })\n+      .catch(() => active && setError(\"Esta sala no esta disponible.\"));\n+    return () => {\n+      active = false;\n+    };\n+  }, [roomId]);\n+\n+  if (error) return <main className=\"round-shell\"><p role=\"alert\">{error}</p></main>;\n+  if (!confirmed) {\n+    return (\n+      <main className=\"round-shell\">\n+        <section className=\"round-card lobby-card\">\n+          <p className=\"eyebrow\">Confirmar entrada</p>\n+          <h1>{room?.code ?? roomId}</h1>\n+          <p>{room ? `${room.humanCount}/${room.capacity} jugadores · ${room.agentReady ? \"IA lista\" : \"IA no disponible\"}` : \"Consultando la sala...\"}</p>\n+          <button type=\"button\" className=\"round-primary\" disabled={!room || room.status !== \"lobby\"} onClick={() => setConfirmed(true)}>\n+            Confirmar alias y entrar\n+          </button>\n+        </section>\n+      </main>\n+    );\n+  }\n \n   return <RoundRoom roomId={roomId} onLeave={() => router.push(\"/\")} />;\n }\n*** End Patch"})
apply_patch({"patchText":"*** Begin Patch\n*** Update File: /home/agent/workspace/src/app/room/[roomId]/page.tsx\n@@\n   const [confirmed, setConfirmed] = useState(false);\n+  const [joining, setJoining] = useState(false);\n@@\n   if (!confirmed) {\n+    async function confirmJoin() {\n+      setJoining(true);\n+      const guest = await fetch(\"/api/auth/guest\", { method: \"POST\" });\n+      const response = guest.ok\n+        ? await fetch(`/api/rooms/${roomId}/join`, {\n+            method: \"POST\",\n+            headers: { \"content-type\": \"application/json\" },\n+            body: JSON.stringify({ alias: \"Gato Ninja\", avatar: \"#21D4D4\" }),\n+          })\n+        : null;\n+      if (!response?.ok) {\n+        setJoining(false);\n+        setError(\"No se pudo entrar en la sala.\");\n+        return;\n+      }\n+      setConfirmed(true);\n+    }\n+\n     return (\n@@\n-          <button type=\"button\" className=\"round-primary\" disabled={!room || room.status !== \"lobby\"} onClick={() => setConfirmed(true)}>\n-            Confirmar alias y entrar\n+          <button type=\"button\" className=\"round-primary\" disabled={!room || room.status !== \"lobby\" || room.humanCount >= room.capacity || joining} onClick={() => void confirmJoin()}>\n+            {joining ? \"Entrando...\" : \"Confirmar alias y entrar\"}\n*** End Patch"})
