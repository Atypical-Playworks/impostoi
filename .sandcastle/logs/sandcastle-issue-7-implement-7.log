apply_patch({"patchText":"*** Begin Patch\n*** Add File: /home/agent/workspace/src/lib/round-ui.test.ts\n+import { describe, expect, test } from \"bun:test\";\n+\n+import {\n+  canSubmitClue,\n+  formatTimer,\n+  phaseTitle,\n+  votingTitle,\n+} from \"./round-ui\";\n+\n+describe(\"round UI presentation rules\", () => {\n+  test(\"formats phase and voting labels in Spanish\", () => {\n+    expect(phaseTitle(\"clue_phase\")).toBe(\"Turno de pistas\");\n+    expect(votingTitle(\"impostor\")).toBe(\"Quien es el impostor?\");\n+  });\n+\n+  test(\"never allows an empty or already submitted clue\", () => {\n+    expect(canSubmitClue(\"   \", false)).toBe(false);\n+    expect(canSubmitClue(\"bosque\", false)).toBe(true);\n+    expect(canSubmitClue(\"otra\", true)).toBe(false);\n+  });\n+\n+  test(\"clamps and formats the visible round timer\", () => {\n+    expect(formatTimer(60)).toBe(\"01:00\");\n+    expect(formatTimer(9)).toBe(\"00:09\");\n+    expect(formatTimer(-1)).toBe(\"00:00\");\n+  });\n+});\n*** Update File: /home/agent/workspace/src/app/globals.css\n@@\n @media (prefers-reduced-motion: reduce) {\n@@\n   }\n }\n+\n+.round-shell {\n+  min-height: 100dvh;\n+  padding: 18px max(18px, 4vw) 36px;\n+  background: radial-gradient(circle at 12% 8%, #51209b 0, transparent 30%), var(--deep);\n+}\n+.round-header {\n+  display: flex;\n+  align-items: center;\n+  justify-content: space-between;\n+  width: min(1180px, 100%);\n+  margin: 0 auto 30px;\n+}\n+.back-button, .connection-status {\n+  display: inline-flex;\n+  align-items: center;\n+  gap: 7px;\n+  color: var(--muted);\n+  font-size: 13px;\n+  font-weight: 900;\n+}\n+.back-button { background: transparent; }\n+.back-button:hover { color: white; }\n+.round-brand { color: white; font-size: 24px; font-weight: 900; text-shadow: 0 3px 0 var(--ink); }\n+.round-brand span { color: var(--cyan); font-size: 11px; letter-spacing: .12em; }\n+.connection-status i { width: 9px; height: 9px; border-radius: 50%; background: #10b981; box-shadow: 0 0 0 4px rgb(16 185 129 / 18%); }\n+.round-layout { display: grid; grid-template-columns: minmax(0, 1fr) 315px; gap: 24px; width: min(1180px, 100%); margin: auto; }\n+.round-main { min-width: 0; }\n+.round-heading { display: flex; align-items: end; justify-content: space-between; gap: 18px; margin-bottom: 18px; }\n+.round-heading h1 { margin: 2px 0 0; font-size: clamp(30px, 5vw, 52px); line-height: 1; text-shadow: 0 4px 0 var(--ink); }\n+.eyebrow { margin: 0; color: var(--yellow); font-size: 12px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }\n+.round-timer { display: inline-flex; align-items: center; gap: 8px; padding: 11px 14px; border: 2px solid var(--pink); border-radius: 14px; background: #2c0b6b; color: white; font-size: 20px; font-weight: 900; box-shadow: 0 4px 0 var(--ink); }\n+.round-card, .word-card, .discussion-banner { border: 3px solid var(--ink); border-radius: 24px; background: rgb(39 10 92 / 94%); box-shadow: 0 7px 0 var(--ink); }\n+.round-card { padding: clamp(20px, 4vw, 34px); }\n+.phase-stack { display: grid; gap: 18px; }\n+.lobby-card, .reveal-card { display: grid; justify-items: center; min-height: 430px; align-content: center; gap: 13px; text-align: center; }\n+.lobby-card h2, .reveal-card h2 { margin: 0; font-size: clamp(27px, 4vw, 42px); text-shadow: 0 3px 0 var(--ink); }\n+.lobby-card p, .reveal-card p { max-width: 420px; margin: 0; color: var(--muted); }\n+.big-round-icon { display: grid; width: 78px; height: 78px; place-items: center; border: 4px solid var(--ink); border-radius: 24px; background: var(--cyan); color: var(--ink); box-shadow: 0 6px 0 #0d7b7b; }\n+.pink-icon { background: var(--pink); box-shadow: 0 6px 0 #9e1060; }\n+.yellow-icon { background: var(--yellow); box-shadow: 0 6px 0 #b89518; }\n+.round-primary { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 13px 18px; border: 3px solid var(--ink); border-radius: 14px; background: var(--cyan); color: var(--ink); box-shadow: 0 5px 0 #0d7b7b; font-weight: 900; }\n+.round-primary:disabled { cursor: not-allowed; opacity: .4; }\n+.word-card { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 18px; padding: 18px 22px; background: #1b0642; }\n+.word-card > span, .secret-word span { color: var(--muted); font-size: 11px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }\n+.word-card > strong { color: var(--cyan); font-size: 23px; }\n+.secret-word { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; padding-top: 12px; border-top: 1px solid #5221a1; }\n+.secret-word b { color: var(--yellow); font-size: 22px; }\n+.card-title { display: flex; align-items: center; gap: 9px; color: var(--pink); }\n+.card-title h2, .discussion-card h2, .vote-card h2 { margin: 0; color: white; font-size: 25px; }\n+.clue-card > p, .discussion-card > p, .vote-card > p { margin: 8px 0 16px; color: var(--muted); }\n+.clue-card textarea, .discussion-card textarea { width: 100%; min-height: 110px; resize: vertical; padding: 14px; border: 2px solid #6d34c6; border-radius: 14px; outline: none; background: #1b0642; color: white; }\n+.clue-card textarea:focus, .discussion-card textarea:focus { border-color: var(--cyan); }\n+.clue-card textarea:disabled { color: var(--muted); opacity: .8; }\n+.card-actions { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 14px; }\n+.submitted-label { display: inline-flex; align-items: center; gap: 6px; color: var(--cyan); font-weight: 900; }\n+.text-button { display: inline-flex; align-items: center; gap: 6px; background: transparent; color: var(--yellow); font-weight: 900; }\n+.clue-list h3 { margin: 0 0 9px; color: var(--muted); font-size: 13px; text-transform: uppercase; }\n+.clue-row { display: grid; grid-template-columns: 130px 1fr; gap: 12px; padding: 11px 13px; border-bottom: 1px solid #5221a1; background: rgb(39 10 92 / 70%); }\n+.clue-row strong { color: var(--cyan); }\n+.clue-row span { color: white; }\n+.discussion-banner { display: flex; align-items: center; gap: 13px; padding: 18px 22px; background: var(--purple); color: white; }\n+.discussion-banner div { display: grid; gap: 4px; }\n+.discussion-banner span { color: #e5d9ff; font-size: 13px; }\n+.discussion-card { display: grid; gap: 12px; }\n+.discussion-card textarea { margin-bottom: 3px; }\n+.vote-stepper { display: flex; align-items: center; justify-content: center; gap: 12px; margin: 2px 0; }\n+.vote-stepper span { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-weight: 900; }\n+.vote-stepper span.active, .vote-stepper span.done { color: var(--cyan); }\n+.vote-stepper small { font-size: 12px; }\n+.vote-stepper i { width: 65px; height: 2px; background: #6d34c6; }\n+.vote-card { text-align: center; }\n+.vote-options { display: grid; grid-template-columns: repeat(2, 1fr); gap: 9px; margin: 18px 0; }\n+.vote-option { display: flex; align-items: center; gap: 9px; padding: 10px; border: 2px solid #5221a1; border-radius: 13px; background: #1b0642; color: white; text-align: left; }\n+.vote-option.selected { border-color: var(--cyan); background: #214f69; }\n+.vote-option svg { margin-left: auto; color: var(--cyan); }\n+.round-avatar { display: inline-grid; width: 36px; height: 36px; flex: 0 0 auto; place-items: center; border: 2px solid var(--ink); border-radius: 50%; color: var(--ink); font-weight: 900; }\n+.reveal-roles { display: flex; gap: 10px; margin: 8px 0; }\n+.reveal-roles span { display: grid; gap: 4px; min-width: 125px; padding: 12px; border-radius: 13px; background: #1b0642; }\n+.reveal-roles b { color: var(--pink); font-size: 11px; }\n+.reveal-roles small { color: white; font-weight: 900; }\n+.round-sidebar { align-self: start; padding: 20px; border: 3px solid var(--ink); border-radius: 22px; background: rgb(29 6 71 / 96%); box-shadow: 0 7px 0 var(--ink); }\n+.sidebar-heading { display: flex; align-items: center; gap: 8px; pa