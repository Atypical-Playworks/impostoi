apply_patch({"patchText":"*** Begin Patch\n*** Add File: /home/agent/workspace/src/lib/round-ui.ts\n+import type { MatchPhase, VotingStage } from \"./game-state\";\n+\n+export function phaseTitle(phase: MatchPhase): string {\n+  switch (phase) {\n+    case \"lobby\":\n+      return \"Sala de espera\";\n+    case \"clue_phase\":\n+      return \"Turno de pistas\";\n+    case \"discussion\":\n+      return \"Discusion abierta\";\n+    case \"voting\":\n+      return \"Votacion privada\";\n+    case \"reveal\":\n+      return \"La verdad sale a la luz\";\n+    case \"results\":\n+      return \"Resultados\";\n+  }\n+}\n+\n+export function votingTitle(stage: VotingStage): string {\n+  return stage === \"ai_detection\" ? \"Quien es la IA?\" : \"Quien es el impostor?\";\n+}\n+\n+export function formatTimer(seconds: number): string {\n+  const safeSeconds = Math.max(0, Math.floor(seconds));\n+  return `${String(Math.floor(safeSeconds / 60)).padStart(2, \"0\")}:${String(\n+    safeSeconds % 60,\n+  ).padStart(2, \"0\")}`;\n+}\n+\n+export function canSubmitClue(clue: string, submitted: boolean): boolean {\n+  return !submitted && clue.trim().length > 0;\n+}\n*** Add File: /home/agent/workspace/src/app/round-room.tsx\n+\"use client\";\n+\n+import {\n+  Check,\n+  ChevronLeft,\n+  Clock3,\n+  MessageCircle,\n+  MessagesSquare,\n+  Send,\n+  Shield,\n+  Sparkles,\n+  Target,\n+  Users,\n+} from \"lucide-react\";\n+import { useState } from \"react\";\n+\n+import type { MatchPhase, VotingStage } from \"@/lib/game-state\";\n+import { canSubmitClue, formatTimer, phaseTitle, votingTitle } from \"@/lib/round-ui\";\n+\n+type RoundParticipant = {\n+  id: string;\n+  alias: string;\n+  avatar: string;\n+  activity: \"idle\" | \"clue\" | \"discussion\" | \"voting\";\n+  isYou?: boolean;\n+};\n+\n+const participants: RoundParticipant[] = [\n+  { id: \"p1\", alias: \"Gato Ninja\", avatar: \"#21D4D4\", activity: \"clue\", isYou: true },\n+  { id: \"p2\", alias: \"Luna Pixel\", avatar: \"#F43FA7\", activity: \"clue\" },\n+  { id: \"p3\", alias: \"Sol Rebelde\", avatar: \"#FFD43B\", activity: \"idle\" },\n+  { id: \"p4\", alias: \"Rio Turbo\", avatar: \"#7C3AED\", activity: \"idle\" },\n+  { id: \"agent\", alias: \"Nube\", avatar: \"#10B981\", activity: \"clue\" },\n+];\n+\n+const starterClues = [\n+  { alias: \"Luna Pixel\", text: \"Tiene una cola muy inquieta.\" },\n+  { alias: \"Nube\", text: \"Le gusta explorar de noche.\" },\n+];\n+\n+const activityLabels = {\n+  idle: \"Listo\",\n+  clue: \"Escribiendo pista\",\n+  discussion: \"En la charla\",\n+  voting: \"Votando\",\n+};\n+\n+export function RoundRoom({ onLeave }: { onLeave: () => void }) {\n+  const [phase, setPhase] = useState<MatchPhase>(\"lobby\");\n+  const [votingStage, setVotingStage] = useState<VotingStage>(\"ai_detection\");\n+  const [clue, setClue] = useState(\"\");\n+  const [submittedClue, setSubmittedClue] = useState<string | null>(null);\n+  const [clues, setClues] = useState(starterClues);\n+  const [discussion, setDiscussion] = useState(\"\");\n+  const [selectedVote, setSelectedVote] = useState<string | null>(null);\n+  const [votes, setVotes] = useState<Partial<Record<VotingStage, string>>>({});\n+\n+  const voteSubmitted = Boolean(votes[votingStage]);\n+  const submitClue = () => {\n+    if (!canSubmitClue(clue, submittedClue !== null)) return;\n+    setSubmittedClue(clue.trim());\n+    setClues((current) => [...current, { alias: \"Gato Ninja\", text: clue.trim() }]);\n+    setClue(\"\");\n+  };\n+  const submitVote = () => {\n+    if (!selectedVote || voteSubmitted) return;\n+    setVotes((current) => ({ ...current, [votingStage]: selectedVote }));\n+    setSelectedVote(null);\n+  };\n+\n+  return (\n+    <main className=\"round-shell\">\n+      <header className=\"round-header\">\n+        <button type=\"button\" className=\"back-button\" onClick={onLeave}>\n+          <ChevronLeft size={18} /> Salir de la sala\n+        </button>\n+        <div className=\"round-brand\">impostoi <span>ROOM IMPOST</span></div>\n+        <div className=\"connection-status\"><i /> Portal conectado</div>\n+      </header>\n+\n+      <div className=\"round-layout\">\n+        <section className=\"round-main\">\n+          <div className=\"round-heading\">\n+            <div>\n+              <p className=\"eyebrow\">Ronda 1 de 3</p>\n+              <h1>{phaseTitle(phase)}</h1>\n+            </div>\n+            <div className=\"round-timer\"><Clock3 size={19} /> {formatTimer(phase === \"discussion\" ? 60 : 20)}</div>\n+          </div>\n+\n+          {phase === \"lobby\" ? (\n+            <Lobby onStart={() => setPhase(\"clue_phase\")} />\n+          ) : null}\n+          {phase === \"clue_phase\" ? (\n+            <CluePhase\n+              clue={clue}\n+              clues={clues}\n+              submittedClue={submittedClue}\n+              onChange={setClue}\n+              onSubmit={submitClue}\n+              onContinue={() => setPhase(\"discussion\")}\n+            />\n+          ) : null}\n+          {phase === \"discussion\" ? (\n+            <Discussion\n+              value={discussion}\n+              onChange={setDiscussion}\n+              onContinue={() => setPhase(\"voting\")}\n+            />\n+          ) : null}\n+          {phase === \"voting\" ? (\n+            <Voting\n+              stage={votingStage}\n+              selected={selectedVote}\n+              submitted={voteSubmitted}\n+              votes={votes}\n+              onSelect={setSelectedVote}\n+              onSubmit={submitVote}\n+              onContinue={() => {\n+                if (votingStage === \"ai_detection\") setVotingStage(\"impostor\");\n+                else setPhase(\"reveal\");\n+              }}\n+            />\n+          ) : null}\n+          {phase === \"reveal\" ? <Reveal onResults={() => setPhase(\"results\")} /> : null}\n+          {phase === \"results\" ? <Results /> : null}\n+        </section>\n+\n+        <aside className=\"round-sidebar\">\n+          <div className=\"sidebar-heading\"><Users size={19} /><strong>Participantes</strong><span>{participants.length}/6</span></div>\n+          <div className=\"participant-list\">\n+            {participants.map((participant) => (\n+              <div className=\"participant-card\" key={participant.id}>\n+                <span className=\"round-avatar\" style={{ backgroundColor: participant.avatar }}>{participant.alias[0]}</span>\n+                <div><strong>{participant.alias}{participant.isYou ? \" (tu)\" : \"\"}</strong><small><i className={`activity-dot ${participant.activity}`} /> {activityLabels[participant.activity]}</small></div>\n+              </div>\n+            ))}\n+          </div>\n+          <div className=\"privacy-note\"><Shield size={17} /><span>Los roles y votos son privados hasta la revelacion.</span></div>\n+        </aside>\n+      </div>\n+    </main>\n+  );\n+}\n+\n+function Lobby({ onStart }: { onStart: () => void }) {\n+  return <div className=\"round-card lobby-card\"><span className=\"big-round-icon\"><Sparkles size={32} /></span><p className=\"eyebrow\">Sala lista</p><h2>Todo el mundo esta dentro</h2><p>Una IA esta jugando con vosotros. Nadie sabe quien es.</p><button type=\"button\" className=\"round-primary\" onClick={onStart}>Comenzar ronda <Target size={19} /></button></div>;\n+}\n+\n+function CluePhase({ clue, clues, submittedClue, onChange, onSubmit, onContinue }: { clue: string; clues: { alias: string; text: string }[]; submittedClue: string | null; onChange: (value: string) => void; onSubmit: () => void; onContinue: () => void }) {\n+  return <div className=\"phase-stack\"><div className=\"word-card\"><span>Categoria</span><strong>Animales</strong><div className=\"secret-word\"><span>Tu palabra secreta</span><b>zorro</b></div></div><div className=\"round-card clue-card\"><div className=\"card-title\"><MessageCircle size={21} /><h2>Da una pista sin regalarla</h2></div><p>Tu pista queda fijada para siempre. Se breve, se astuto.</p><textarea value={clue} disabled={submittedClue !== null} onChange={(event) => onChange(event.target.value)} placeholder=\"Escribe una palabra o frase corta...\" maxLength={100} /><div className=\"card-actions\">{submittedClue ? <span className=\"submitted-label\"><Check size={17} /> Pista enviada</span> : <button type=\"button\" className=\"round-primary\" disabled={!canSubmitClue(clue, false)} onClick={onSubmit}><Send size={17} /> Enviar pista</button>}{clues.length >= 5 || submittedClue ? <button type=\"button\" className=\"text-button\" onClick={onContinue}>Ir a la discusion <Target size={16} /></button> : null}</div></div><div className=\"clue-list\"><h3>Pistas en la mesa</h3>{clues.map((item) => <div className=\"clue-row\" key={`${item.alias}-${item.text}`}><strong>{item.alias}</strong><span>{item.text}</span></div>)}</div></div>;\n+}\n+\n+function Discussion({ value, onChange, onContinue }: { value: string; onChange: (value: string) => void; onContinue: () => void }) {\n+  return <div className=\"phase-stack\"><div className=\"discussion-banner\"><MessagesSquare size={31} /><div><strong>60 segundos para discutir</strong><span>Comparad las pistas. La charla se cerrara al votar.</span></div></div><div className=\"round-card discussion-card\"><h2>Que te llama la atencion?</h2><p>Este mensaje es una demostracion de la conversacion publica de la sala.</p><textarea value={value} onChange={(event) => onChange(event.target.value)} placeholder=\"Escribe al grupo...\" maxLength={280} /><button type=\"button\" className=\"round-primary\" onClick={onContinue}>Cerrar discusion y votar <Target size={18} /></button></div></div>;\n+}\n+\n+function Voting({ stage, selected, submitted, votes, onSelect, onSubmit, onContinue }: { stage: VotingStage; selected: string | null; submitted: boolean; votes: Partial<Record<VotingStage, string>>; onSelect: (id: string) => void; onSubmit: () => void; onContinue: () => void }) {\n+  return <div className=\"phase-stack\"><div className=\"vote-stepper\"><span className=\"done\">1 <small>IA</small></span><i /><span className={stage === \"impostor\" ? \"active\" : \"\"}>2 <small>Impostor</small></span></div><div className=\"round-card vote-card\"><p className=\"eyebrow\">Votacion {stage === \"ai_detection\" ? \"1 de 2\" : \"2 de 2\"}</p><h2>{votingTitle(stage)}</h2><p>Tu voto es privado y no se puede cambiar.</p><div className=\"vote-options\">{participants.map((participant) => <button type=\"button\" className={selected === participant.id || votes[stage] === participant.id ? \"vote-option selected\" : \"vote-option\"} disabled={submitted} onClick={() => onSelect(participant.id)} key={participant.id}><span className=\"round-avatar\" style={{ backgroundColor: participant.avatar }}>{participant.alias[0]}</span><strong>{participant.alias}</strong>{votes[stage] === participant.id ? <Check size={18} /> : null}</button>)}</div><button type=\"button\" className=\"round-primary\" disabled={!selected || submitted} onClick={onSubmit}>{submitted ? \"Voto enviado\" : \"Confirmar voto\"}</button>{submitted ? <button type=\"button\" className=\"text-button\" onClick={onContinue}>{stage === \"ai_detection\" ? \"Siguiente votacion\" : \"Ver resultado\"} <Target size={16} /></button> : null}</div></div>;\n+}\n+\n+function Reveal({ onResults }: { onResults: () => void }) {\n+  return <div className=\"round-card reveal-card\"><span className=\"big-round-icon pink-icon\"><Target size={32} /></span><p className=\"eyebrow\">Votacion cerrada</p><h2>La IA era Nube</h2><p>Y el impostor de esta ronda era <strong>Rio Turbo</strong>.</p><div className=\"reveal-roles\"><span><b>IA</b><small>Nube</small></span><span><b>IMPOSTOR</b><small>Rio Turbo</small></span></div><button type=\"button\" className=\"round-primary\" onClick={onResults}>Ver resultados <Target size={19} /></button></div>;\n+}\n+\n+function Results() {\n+  return <div className=\"round-card reveal-card\"><span className=\"big-round-icon yellow-icon\"><Check size={32} /></span><p className=\"eyebrow\">Ronda completada</p><h2>Buen ojo, equipo</h2><p>La siguiente ronda cambiara la palabra y los roles.</p><button type=\"button\" className=\"round-primary\">Preparar ronda 2 <Target size={19} /></button></div>;\n+}\n*** Update File: /home/agent/workspace/src/app/page.tsx\n@@\n import Image from \"next/image\";\n import { useId, useState } from \"react\";\n+\n+import { RoundRoom } from \"./round-room\";\n@@\n-function CreateRoomModal({ onClose }: { onClose: () => void }) {\n+function CreateRoomModal({ onClose, onEnter }: { onClose: () => void; onEnter: () => void }) {\n@@\n-           <button type=\"button\" className=\"modal-primary\" onClick={onClose}>\n+           <button type=\"button\" className=\"modal-primary\" onClick={onEnter}>\n@@\n-function JoinRoomModal({ onClose }: { onClose: () => void }) {\n+function JoinRoomModal({ onClose, onEnter }: { onClose: () => void; onEnter: () => void }) {\n@@\n-             onClick={onClose}\n+             onClick={onEnter}\n@@\n   const [languageOpen, setLanguageOpen] = useState(false);\n   const [modal, setModal] = useState<\"create\" | \"join\" | null>(null);\n+  const [inRoom, setInRoom] = useState(false);\n@@\n-    <main className=\"game-shell\">\n+    <main className=\"game-shell\">\n+      {inRoom ? <RoundRoom onLeave={() => setInRoom(false)} /> : null}\n+      {inRoom ? null : <>\n@@\n-      {modal === \"create\" ? (\n-        <CreateRoomModal onClose={() => setModal(null)} />\n+      {modal === \"create\" ? (\n+        <CreateRoomModal onClose={() => setModal(null)} onEnter={() => { setModal(null); setInRoom(true); }} />\n       ) : null}\n       {modal === \"join\" ? (\n-        <JoinRoomModal onClose={() => setModal(null)} />\n+        <JoinRoomModal onClose={() => setModal(null)} onEnter={() => { setModal(null); setInRoom(true); }} />\n       ) : null}\n+      </>}\n*** End Patch"})
