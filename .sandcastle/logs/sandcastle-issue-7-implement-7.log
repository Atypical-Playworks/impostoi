ase]);\n@@\n-              <p className=\"eyebrow\">Ronda 1 de 3</p>\n+              <p className=\"eyebrow\">Ronda {roundNumber} de 3</p>\n               <h1>{phaseTitle(phase)}</h1>\n             </div>\n-            <div className=\"round-timer\">\n-              <Clock3 size={19} />{\" \"}\n-              {formatTimer(phase === \"discussion\" ? 60 : 20)}\n-            </div>\n+            {secondsLeft === null ? null : (\n+              <div className=\"round-timer\">\n+                <Clock3 size={19} /> {formatTimer(secondsLeft)}\n+              </div>\n+            )}\n@@\n               value={discussion}\n+              secondsLeft={secondsLeft ?? 0}\n               onChange={setDiscussion}\n@@\n           {phase === \"reveal\" ? (\n-            <Reveal onResults={() => setPhase(\"results\")} />\n+            <Reveal\n+              agentAlias=\"Nube\"\n+              impostorAlias=\"Rio Turbo\"\n+              onResults={() => setPhase(\"results\")}\n+            />\n           ) : null}\n-          {phase === \"results\" ? <Results /> : null}\n+          {phase === \"results\" ? (\n+            <Results\n+              roundNumber={roundNumber}\n+              onNextRound={() => {\n+                setRoundNumber((current) => Math.min(3, current + 1));\n+                setPhase(\"clue_phase\");\n+                setVotingStage(\"ai_detection\");\n+                setClue(\"\");\n+                setSubmittedClue(null);\n+                setClues(starterClues);\n+                setDiscussion(\"\");\n+                setSelectedVote(null);\n+                setVotes({});\n+              }}\n+            />\n+          ) : null}\n@@\n function Discussion({\n   value,\n+  secondsLeft,\n   onChange,\n@@\n   value: string;\n+  secondsLeft: number;\n@@\n }) {\n-  const [secondsLeft, setSecondsLeft] = useState(60);\n-\n-  useEffect(() => {\n-    const interval = window.setInterval(() => {\n-      setSecondsLeft((current) => Math.max(0, current - 1));\n-    }, 